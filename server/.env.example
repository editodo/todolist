# Copy to server/.env and fill in. Never commit server/.env.
NODE_ENV=production
PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=editodo
DB_PASSWORD=
DB_NAME=editodo

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=

# Admin dashboard login (web only). Leave empty to disable admin login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: comma-separated browser origins allowed to call the API
# CORS_ORIGINS=https://editodo.com,https://www.editodo.com

# Days to keep expired guest accounts before cleanup_guests.js deletes them
GUEST_RETENTION_DAYS=30

# Password reset mail (Resend). MAIL_FROM must use a domain verified in Resend → Domains.
RESEND_API_KEY=
MAIL_FROM=EdiTodo <no-reply@codemodo.kr>

# Google sign-in: the "Web application" OAuth client ID (same as GOOGLE_WEB_CLIENT_ID in client/config.js).
# Comma-separate if you add more clients.
GOOGLE_CLIENT_IDS=

# Sign in with Apple. Bundle ID defaults to com.editodo.app.
# TEAM/KEY/PRIVATE_KEY let the server revoke Apple logins on account deletion (App Store rule 5.1.1(v)).
# Apple Developer → Keys → + → "Sign in with Apple" → download the .p8 once; paste it on ONE line with \n for line breaks.
APPLE_BUNDLE_ID=com.editodo.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Sign in with Apple on the web (editodo.com): the Services ID created in Apple Developer → Identifiers → Services IDs.
APPLE_SERVICES_ID=

# Kakao login (developers.kakao.com → 내 애플리케이션). REST API key = the app's client ID (also in client/config.js).
# 카카오 로그인 → Redirect URI must list KAKAO_REDIRECT_URI exactly. 보안 → Client Secret (recommended).
# Admin key lets the server unlink Kakao on account deletion. KAKAO_WEB_ORIGIN = where the web app runs (dev: http://localhost:8082).
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
KAKAO_REDIRECT_URI=https://editodo.com/api/auth/kakao/callback
KAKAO_WEB_ORIGIN=https://editodo.com
